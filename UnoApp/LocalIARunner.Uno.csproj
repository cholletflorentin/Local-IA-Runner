<Project Sdk="Uno.Sdk">
  <PropertyGroup>
    <TargetFrameworks>net10.0-android;net10.0-desktop</TargetFrameworks>
    <OutputType>Exe</OutputType>
    <UnoSingleProject>true</UnoSingleProject>
    <ApplicationTitle>Local IA Runner</ApplicationTitle>
    <ApplicationId>fr.localiarunner.uno</ApplicationId>
    <ApplicationDisplayVersion>0.1.0</ApplicationDisplayVersion>
    <ApplicationVersion>1</ApplicationVersion>
    <Description>Local IA Runner cross-platform beta</Description>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UnoFeatures>Skia</UnoFeatures>
  </PropertyGroup>
  <ItemGroup Condition="'$(TargetFramework)' == 'net10.0-android'">
    <AndroidAsset Include="Assets/llama-b12676-android-arm64.tar.gz" />
    <AndroidAsset Include="Assets/llama.cpp-LICENSE.txt" />
    <AndroidAsset Include="THIRD-PARTY-NOTICES.txt" />
  </ItemGroup>
</Project>
