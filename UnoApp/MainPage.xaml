<Page
    x:Class="LocalIARunner.Uno.MainPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Background="#101319"
    SizeChanged="OnPageSizeChanged">
    <Grid x:Name="RootGrid" Padding="16" RowDefinitions="Auto,*,Auto" ColumnDefinitions="220,*">
        <StackPanel Grid.Row="0" Grid.ColumnSpan="2" Spacing="10" Margin="0,0,0,12">
            <Grid ColumnDefinitions="*,Auto,Auto,Auto" ColumnSpacing="8">
                <StackPanel VerticalAlignment="Center">
                    <TextBlock x:Name="TitleText" Text="Local IA Runner" FontSize="22" FontWeight="SemiBold" />
                    <TextBlock x:Name="TaglineText" Text="Bêta Uno Platform · Windows, macOS, Linux et Android" Foreground="#9AA4B2" FontSize="12" />
                </StackPanel>
                <ComboBox x:Name="ModelPicker" Grid.Column="1" MinWidth="160" PlaceholderText="Modèle" VerticalAlignment="Center" />
                <Button x:Name="RefreshModelsButton" Grid.Column="2" Content="Actualiser" Click="OnRefreshModelsClick" VerticalAlignment="Center" />
                <Button x:Name="NewChatButton" Grid.Column="3" Content="Nouvelle discussion" Click="OnNewChatClick" VerticalAlignment="Center" />
            </Grid>
            <Grid x:Name="ConnectionGrid" ColumnDefinitions="*,180,Auto" ColumnSpacing="8">
                <TextBox x:Name="EndpointBox" PlaceholderText="Adresse du serveur, ex. http://127.0.0.1:8080" />
                <PasswordBox x:Name="ApiKeyBox" Grid.Column="1" PlaceholderText="Clé API (facultative)" />
                <Button x:Name="ConnectButton" Grid.Column="2" Content="Enregistrer et connecter" Click="OnConnectClick" />
            </Grid>
            <Grid x:Name="AndroidModelPanel" ColumnDefinitions="Auto,*" ColumnSpacing="8" Visibility="Collapsed">
                <Button x:Name="ChooseModelButton" Content="Choisir un modèle GGUF" Click="OnChooseLocalModelClick" />
                <TextBlock x:Name="LocalModelText" Grid.Column="1" Text="Aucun modèle GGUF choisi" VerticalAlignment="Center" Foreground="#AAB4C1" TextTrimming="CharacterEllipsis" />
            </Grid>
            <ComboBox x:Name="MobileConversationPicker" PlaceholderText="Choisir une discussion" ItemsSource="{x:Bind Conversations}" SelectionChanged="OnMobileConversationSelectionChanged" Visibility="Collapsed">
                <ComboBox.ItemTemplate>
                    <DataTemplate>
                        <TextBlock Text="{Binding Title}" TextTrimming="CharacterEllipsis" />
                    </DataTemplate>
                </ComboBox.ItemTemplate>
            </ComboBox>
            <TextBlock x:Name="StatusText" Text="Connecte-toi à un serveur llama.cpp compatible avec l’API OpenAI." Foreground="#AAB4C1" TextWrapping="Wrap" />
        </StackPanel>

        <Border x:Name="ConversationPane" Grid.Row="1" Grid.Column="0" Background="#171B23" CornerRadius="8" Padding="10" Margin="0,0,12,0">
            <Grid RowDefinitions="Auto,*">
                <TextBlock Text="Discussions" FontWeight="SemiBold" Margin="4,4,4,10" />
                <ListView x:Name="ConversationList" Grid.Row="1" ItemsSource="{x:Bind Conversations}" SelectionChanged="OnConversationSelectionChanged" Background="Transparent" BorderThickness="0">
                    <ListView.ItemTemplate>
                        <DataTemplate>
                            <TextBlock Text="{Binding Title}" TextWrapping="Wrap" MaxLines="3" Padding="4" />
                        </DataTemplate>
                    </ListView.ItemTemplate>
                </ListView>
            </Grid>
        </Border>

        <Border Grid.Row="1" Grid.Column="1" Background="#171B23" CornerRadius="8" Padding="12">
            <ScrollViewer x:Name="MessageScroller" VerticalScrollBarVisibility="Auto">
                <ItemsControl ItemsSource="{x:Bind Messages}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border Background="#202631" CornerRadius="8" Padding="12" Margin="0,0,0,10">
                                <StackPanel Spacing="5">
                                    <TextBlock Text="{Binding Role}" FontWeight="SemiBold" Foreground="#AFC8FF" />
                                    <TextBlock Text="{Binding Content}" TextWrapping="Wrap" />
                                </StackPanel>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>
        </Border>

        <Grid Grid.Row="2" Grid.Column="1" Margin="0,12,0,0" ColumnDefinitions="*,Auto,Auto" ColumnSpacing="8">
            <TextBox x:Name="PromptBox" PlaceholderText="Écris un message… (Entrée pour envoyer)" AcceptsReturn="True" TextWrapping="Wrap" MinHeight="72" MaxHeight="180" KeyDown="OnPromptKeyDown" />
            <Button x:Name="SendButton" Grid.Column="1" Content="Envoyer" MinWidth="100" Click="OnSendClick" VerticalAlignment="Bottom" />
            <Button x:Name="CancelButton" Grid.Column="2" Content="Annuler" IsEnabled="False" Click="OnCancelClick" VerticalAlignment="Bottom" />
        </Grid>
        <TextBlock x:Name="MobileStatusText" Grid.Row="2" Grid.Column="0" VerticalAlignment="Center" Foreground="#9AA4B2" Text="Prêt" TextWrapping="Wrap" />
    </Grid>
</Page>
